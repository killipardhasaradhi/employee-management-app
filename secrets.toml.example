# ============================================================
# STREAMLIT SECRETS TEMPLATE
# ============================================================
# DO NOT commit a filled-in version of this file to GitHub.
#
# For local development:
#   1. Copy this file to  .streamlit/secrets.toml  (that exact path)
#   2. Fill in your real values below
#   3. Make sure .streamlit/secrets.toml is in your .gitignore
#
# For Streamlit Community Cloud (your deployed app):
#   1. Go to https://share.streamlit.io
#   2. Open your app → Settings (⋮ menu) → Secrets
#   3. Paste the filled-in contents of this file there directly
#      (Streamlit Cloud stores it outside your git repo)
# ============================================================

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SUPABASE_ANON_KEY"
SUPER_ADMIN_EMAIL = "your-super-admin@example.com"
SENDER_EMAIL = "your-sending-gmail@example.com"
SENDER_PASSWORD = "your-gmail-app-password"
